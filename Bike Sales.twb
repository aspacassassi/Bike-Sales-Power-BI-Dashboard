              <calculation class='tableau' formula='If [Date - Year] = dateadd(&apos;year&apos;, -1, [Parameters].[Parameter 1]) then [Profit] end' />
            </column>
            <column caption='YoY% Change' datatype='real' name='[Calculation_0225456722878469]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_0225456722292739])- sum([Calculation_0225456722546692])) / sum([Calculation_0225456722546692])' />
            </column>
            <column caption='&quot;YoY% Change&quot;' datatype='string' name='[Calculation_0225456723623943]' role='dimension' type='nominal' user:unnamed='YoY Percent Change'>
